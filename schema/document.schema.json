{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ict-knowledge-base/document.schema.json",
  "title": "Knowledge base document front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "category", "source_type", "freshness_tier",
    "status", "last_verified", "owner"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 120 },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "category": {
      "enum": [
        "about", "admissions", "programs", "procedures", "finance", "erp", "campus",
        "transport", "canteen", "timetables", "people", "student-life", "announcements"
      ]
    },
    "subcategory": { "type": ["string", "null"] },
    "program_level": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["all", "bachelor", "masters", "phd"] }
    },
    "department": { "type": ["string", "null"] },
    "language": { "enum": ["en", "fr"] },
    "source_type": {
      "enum": ["official_doc", "website", "interview", "sheet", "image", "observation"]
    },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cloudinary_id", "kind", "description"],
        "properties": {
          "cloudinary_id": { "type": "string", "minLength": 3 },
          "kind": { "enum": ["pdf", "docx", "image", "sheet"] },
          "description": { "type": "string", "minLength": 10 },
          "text_file": { "type": ["string", "null"] },
          "collected_on": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "academic_year": { "type": ["string", "null"], "pattern": "^[0-9]{4}/[0-9]{4}$" },
    "semester": { "enum": ["S1", "S2", null] },
    "valid_from": { "type": ["string", "null"], "format": "date" },
    "valid_until": { "type": ["string", "null"], "format": "date" },
    "freshness_tier": { "enum": ["realtime", "daily", "semester", "static"] },
    "status": { "enum": ["draft", "verified", "deprecated"] },
    "last_verified": { "type": "string", "format": "date" },
    "verified_by": { "type": ["string", "null"] },
    "owner": { "type": "string", "minLength": 2 },
    "collected_by": { "type": ["string", "null"] },
    "collected_on": { "type": ["string", "null"], "format": "date" },
    "confirmed_in_writing": { "type": "boolean" },
    "conflict_note": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
