FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 KB_ROOT=/app
WORKDIR /app

# Tesseract provides OCR for images collected through the intake command
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-fra tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[ocr]"

COPY schema ./schema
COPY sources ./sources
COPY db ./db
COPY content ./content
COPY eval ./eval

ENTRYPOINT ["ictkb"]
CMD ["--help"]
