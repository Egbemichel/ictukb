# Copy to .env for local use. Never commit the populated file.

# PostgreSQL with the pgvector extension (Neon: use the pooled connection string, sslmode=require)
DATABASE_URL=postgresql://ictkb:ictkb@localhost:5432/ictkb

# production indexes only status=verified documents; staging also indexes status=draft
KB_ENV=staging

# Embeddings: worker (Cloudflare Workers AI through the deployed Worker, free) | cohere | fastembed | hash (tests only)
EMBEDDING_PROVIDER=worker
KB_WORKER_URL=https://ictkb-api.ictkb-api-worker.workers.dev
COHERE_API_KEY=
# Minimum cosine similarity of the best result for a query to count as answered
MIN_SIMILARITY=0.64
# Vision model used to read menu images posted by the WhatsApp listener
VISION_MODEL=command-a-vision-07-2025

# API access
REQUIRE_API_KEY=true
ADMIN_TOKEN=
DEFAULT_RATE_LIMIT_PER_MIN=60
CORS_ORIGINS=*

# Cloudinary (files and images)
CLOUDINARY_CLOUD_NAME=ljouzf0i
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
